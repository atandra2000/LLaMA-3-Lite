  "claims": [
    {
      "id": "claim_f6b4068934914c528c84b0b3908dbbb5",
      "statement": "`load_checkpoint` is called only when `config.get('preload')` is non-`None`; the value of `preload` is not used as a pathname. The loader scans `model_folder` for `<model_filename>_step_*.pt`, orders candidates by numeric step suffix, and loads the newest matching file.",
      "evidence": [
        {
          "resource": "repo://train.py#L212-L247",
          "version": "repo-lines-v1:sha256:15507cf325a61d0701f35f6ec97ba12047e13c283fc28acc44aa9d1069359b92:"
        },
        {
          "resource": "repo://train.py#L409-L412",
          "version": "repo-lines-v1:sha256:d3d18af20e9cb2b413b0ee46626fd6f389b7912e675bb95483d79194b19557f1:"
        }
      ]
    },
    {
      "id": "claim_c2bc271bad044f7d81917481d9fd3410",
      "statement": "If no matching numeric step checkpoint exists, `load_checkpoint` returns `(0, float('inf'))` without raising, so a non-`None` `preload` value alone does not establish that a resume occurred.",
      "evidence": [
        {
          "resource": "repo://tests/test_train.py#L197-L217",
          "version": "repo-lines-v1:sha256:810d7bdfcfc13c0fc9fd49d02d4aebbb31d051540a82f9badca6a5dd280ded28:"
