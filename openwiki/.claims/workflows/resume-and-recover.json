        }
      ]
    },
    {
      "id": "claim_8f8a9d4e3d824803aa3a374d802ed0a5",
      "statement": "Periodic checkpoints contain live model state, optimizer state, scheduler state, step, derived token count, best validation loss, configuration, Torch/NumPy/Python RNG state, and optional EMA state; CUDA RNG state is also saved when CUDA is available.",
      "evidence": [
        {
          "resource": "repo://train.py#L168-L188",
          "version": "repo-lines-v1:sha256:80105df22d17f541991ddf84ccb10253b1e4dcd0b6fc2806bb66c5de9f1465ea:"
        }
      ]
    },
    {
      "id": "claim_099d1068c2c7463bb3e84aeaeed4a9cc",
      "statement": "Loading a valid checkpoint restores model, optimizer, scheduler, Python/NumPy/Torch RNG state, CUDA RNG state when present and available, and EMA state when the caller supplies an EMA object and the checkpoint contains one; it returns the saved step and best validation loss.",
      "evidence": [
        {
          "resource": "repo://tests/test_train.py#L105-L147",
          "version": "repo-lines-v1:sha256:07eedfdf4179c4cad0ffbfda0908e8c4d2f5ac7e978de4713472d269e289b7f3:"
