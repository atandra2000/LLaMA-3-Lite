        }
      ]
    },
    {
      "id": "claim_bc3e9d0390ac4b9d819aa2b5680c73e3",
      "statement": "Checkpoint loading normalizes serialized Torch and CUDA RNG tensors to CPU `torch.uint8` before installing them, allowing RNG state saved on CUDA to be loaded onto CPU without passing a device-resident RNG tensor to the RNG setters.",
      "evidence": [
        {
          "resource": "repo://tests/test_train.py#L242-L301",
          "version": "repo-lines-v1:sha256:4599227579c70395e45ec6ec8e47adfa224b42e71ff33a3c121fc2d3aaab6e37:"
