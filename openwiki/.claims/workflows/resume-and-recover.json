    {
      "id": "claim_e9439899e0e848e28e9f1cad9e325706",
      "statement": "The checkpoint does not persist a DataLoader iterator, sampler permutation, worker state, or epoch cursor; data exhaustion is handled separately by `_next_batch`, which increments epoch state, updates samplers that provide `set_epoch`, and starts a fresh iterator.",
