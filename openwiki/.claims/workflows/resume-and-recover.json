    {
      "id": "claim_43222565846a4e5a96f08934473d53da",
      "statement": "Validation uses EMA weights when EMA is enabled, but a strict validation improvement saves the live model's `state_dict()` to `<model_folder>/<model_filename>_best.pt`; equal losses do not replace the existing best artifact.",
      "evidence": [
        {
