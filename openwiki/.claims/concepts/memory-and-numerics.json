    {
      "id": "claim_d80f910700254976bba64e277c597e76",
      "statement": "The intended numerical objective is cross-entropy plus `z_loss_weight * mean(logsumexp(float(logits), dim=-1)^2)`; loss reductions promote logits to FP32, and tests compare the chunked and dense objectives within representative `1e-5` tolerances while checking finite gradients and increasing penalty with larger logit magnitude.",
      "evidence": [
        {
          "resource": "repo://model.py#L239-L261",
          "version": "repo-lines-v1:sha256:990103017985e2bcc5815830ed5bc4a804348cfe93bb2ac037eec6ebafbe13ac:"
