      "id": "claim_5180b2e90a4a472d8455675087778162",
      "statement": "The pure-PyTorch head loss accumulates CE numerators, valid-token counts, and z-loss numerators across chunks, excludes `ignore_index` rows from both averages, and safely returns zero terms when there are no valid targets; gradients flow through the chunked computation to both hidden states and the head weight.",
      "evidence": [
        {
          "resource": "repo://model.py#L291-L330",
          "version": "repo-lines-v1:sha256:5df6176482b707e0f3abd9f5134d09d04e7545e2ac2bd560c14d0dce615072c8:"
