    {
      "id": "claim_35d65f45e23640eeadb127e85ab95a88",
      "statement": "GroupedQueryAttention projects Q to n_heads*head_dim and K/V to n_kv_heads*head_dim, repeats K/V by n_heads // n_kv_heads, uses causal scaled dot-product attention, merges heads, and returns d_model-width output.",
      "evidence": [
        {
          "resource": "repo://model.py#L53-L102",
