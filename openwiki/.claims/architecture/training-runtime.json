          "version": "repo-lines-v1:sha256:c75b2e1832c55efc21fd179709921ee50efc2613df29a8f0139ad026fe494ba4:"
        }
      ]
    },
    {
      "id": "claim_18173e1eba2a493ea880ca2cb2c12402",
      "statement": "The train iterator wraps around corpus exhaustion rather than terminating: `_next_batch` increments epoch state, calls `sampler.set_epoch` when supported, prints a corpus-exhaustion warning, and starts a fresh iterator.",
