        }
      ]
    },
    {
      "id": "claim_4f66f22acb924617ae0b7f3c272552de",
      "statement": "Training computes loss from hidden states through `chunked_head_cross_entropy_with_z`, which projects the output head and evaluates FP32 CE plus z-loss in checkpointed row chunks instead of materializing the full logits matrix; the trainer scales the loss by `gradient_accumulation` before backward.",
      "evidence": [
        {
          "resource": "repo://model.py#L264-L330",
          "version": "repo-lines-v1:sha256:9483d47a0e87be7ae1fa6099768d157a1b8c2e2801c0b2afaf6b6ebd51cb57b9:"
        },
