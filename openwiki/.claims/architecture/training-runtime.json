    {
      "id": "claim_e39666cdaa9348ac86fa67d34fe041b1",
      "statement": "Compile warmup consumes an actual first DataLoader batch before optimizer construction; when compilation is enabled and available, the trainer compiles with the configured mode and runs a hidden-state forward, chunked loss, backward pass, and CUDA synchronization before proceeding.",
      "evidence": [
        {
          "resource": "repo://train.py#L347-L376",
          "version": "repo-lines-v1:sha256:ce91f26cb8b6c7f7976b30be08a06e2b587bef24b8ab5a0d9c160b733a215095:"
        }
      ]
    },
    {
      "id": "claim_02b137d31f8f41eba4304729bf930afe",
      "statement": "The warmup backward pass occurs before the optimizer exists and without an explicit warmup gradient clear, so warmup gradients remain on parameters until the first optimizer boundary; the warmup batch itself is consumed and the subsequent iterator item becomes the first training batch.",
      "evidence": [
        {
          "resource": "repo://train.py#L347-L373",
          "version": "repo-lines-v1:sha256:63fd025aaf396b8f5dda726cf6ca8d4843a8b8a73f8c3d10335bb5129900ee36:"
