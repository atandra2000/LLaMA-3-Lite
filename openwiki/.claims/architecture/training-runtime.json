    {
      "id": "claim_e6ff6fdc793b4ba5a2ab338031c5ae14",
      "statement": "Triton implementations are explicitly gated: if any of `rmsnorm_impl`, `swiglu_impl`, or `cross_entropy_impl` requests `triton` without `ENABLE_TRITON_KERNELS=1`, `train_model` force-restores all three implementations to `pytorch`; an opted-in unavailable cross-entropy Triton path raises an explicit `ImportError` rather than silently falling back.",
      "evidence": [
        {
          "resource": "repo://model.py#L264-L289",
          "version": "repo-lines-v1:sha256:ed67ba0a5927f50e4872b93fc70520fc2419fa21cfbe0b906dd468dfdd8f587a:"
