    {
      "id": "claim_ab7d9820569e40c59d0810b03869fe21",
      "statement": "Runtime data uses a read-only `uint32` memmap split into chunk-aligned, non-overlapping next-token windows, with shuffled `drop_last=True` training batches and ordered, non-dropping validation batches transferred with `non_blocking=True`.",
