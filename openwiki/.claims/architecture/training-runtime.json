          "resource": "repo://train.py#L492-L507",
          "version": "repo-lines-v1:sha256:50658ce0a8d6249ab3c3de6d4936aa313f5792fe544a813be4ef7c3e038118a0:"
        }
      ]
    },
    {
      "id": "claim_3c3b16f1ed6447d1bec2a05502e530cf",
      "statement": "An optimizer boundary occurs when `(step + 1) % grad_accum_steps == 0`; the trainer clips gradients, calls AdamW, updates EMA from the post-step model, clears gradients with `set_to_none=True`, and then steps the sequential warmup/cosine scheduler, so EMA and scheduler updates happen only at boundaries.",
      "evidence": [
        {
          "resource": "repo://train.py#L378-L407",
          "version": "repo-lines-v1:sha256:8165f4dc3b0f199f7c59d1838bb3eb3c4a2dc1717ee6878e628ce73b21cbb0b0:"
        },
        {
