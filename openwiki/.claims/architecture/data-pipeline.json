      "id": "claim_bc43d42fe9f340639c9fba96ceec63af",
      "statement": "This repository separates corpus preparation from runtime loading: data/prepare_data.py delegates download, cleaning, tokenization, and packing to the workspace-level LLM/shared_data package, while the in-repository data/shared_data package provides only the loader.",
      "evidence": [
        {
          "resource": "repo://data/prepare_data.py#L93-L105",
          "version": "repo-lines-v1:sha256:9db3165c42acf26fdc8f4746b2d3ed34262fc712fde4285cd97f4f6fd7560969:"
