        }
      ]
    },
    {
      "id": "claim_243ef84d6a1542659f23a0c2bd2b970e",
      "statement": "The preparation bridge converts workspace shards into the configured flat cache by reading manifest entries in numeric index order, streaming bounded byte chunks, and atomically replacing a sibling .tmp file with os.replace.",
