    {
      "id": "claim_2f78084b87704d96bb37e61708a910a0",
      "statement": "The repository separates real-data preparation from runtime loading: data/prepare_data.py is a shim over the workspace-level LLM/shared_data preparation package, while data/shared_data/loader.py owns the PackedDataset and DataLoader runtime contract, and dataset.py re-exports the loader API for train.py and benchmark_data.py.",
      "evidence": [
        {
          "resource": "repo://data/prepare_data.py#L1-L15",
          "version": "repo-lines-v1:sha256:b0bf036f639dd1e2e0a63acf45bac7893c7b0b8b955d6702eec725376c18b643:"
