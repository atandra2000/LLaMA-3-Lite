    {
      "id": "claim_89effb8a189646609b35369c7452b045",
      "statement": "The preparation adapter concatenates manifest-indexed shards in numeric order using bounded streaming and atomically installs the configured cache via a sibling temporary file; `reuse_data_cache=True` skips concatenation when the cache already exists.",
