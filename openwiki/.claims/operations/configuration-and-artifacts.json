  "claims": [
    {
      "id": "claim_16a5b64f134b426c96456624f92bfad3",
      "statement": "`config.py:get_config()` is the single source of the model, optimization, data, evaluation, checkpoint, and telemetry settings used by the training entrypoint.",
      "evidence": [
        {
          "resource": "repo://config.py#L1-L6",
          "version": "repo-lines-v1:sha256:803ba74790066675295ec944c58711b28a7c80a6ea5d71d93c1e63ffd95c306d:"
        },
        {
